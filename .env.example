NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used in invite emails (example: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email of the first admin (must already exist in Supabase Auth)
ADMIN_BOOTSTRAP_EMAIL=

# Keep false in production
ALLOW_FIRST_ADMIN=false

# Brevo (invite + password reset). Create an API key and a sender in brevo.com
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=AXIS
